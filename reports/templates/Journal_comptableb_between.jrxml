<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Journal_comptableb_between" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="13cf738a-3a93-4baf-aef6-c6f068465d77">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MAINS/ins.xml"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="198"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="797"/>
	<parameter name="date1" class="java.sql.Timestamp"/>
	<parameter name="date2" class="java.sql.Timestamp"/>
	<queryString>
		<![CDATA[SELECT id_ecriture, 
	ref_facture, 
	date_operation, 
	compte, num_compte, 
	libelle_compte,
	 montant,
	 (select sum(montant) 
	 		from public.v_ecriture 
	 		where   CAST( date_operation AS DATE) between CAST($P{date1} AS DATE)   and  CAST($P{date2} AS DATE) and type_operation ='CREDIT'
	 ) as total_credit,
	 (select sum(montant) 
	 		from public.v_ecriture 
	 		where   CAST( date_operation AS DATE) between CAST($P{date1} AS DATE)   and  CAST($P{date2} AS DATE) and type_operation ='DEBIT'
	 ) as total_debit,
	 type_operation, 
	 designation,
	  who_done,
	   when_done, 
	   libelle_journal, 
	   ref_depense, 
	   date_depense
	FROM public.v_ecriture
where   CAST( date_operation AS DATE) between CAST($P{date1} AS DATE)   and  CAST($P{date2} AS DATE)]]>
	</queryString>
